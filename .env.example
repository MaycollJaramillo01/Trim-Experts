# Copy to .env and fill in. Never commit .env.

# Production origin, e.g. https://www.example.com (no trailing path).
# Required by `npm run build`. Used for canonicals, Open Graph URLs, sitemap and JSON-LD.
# Leave empty until the client confirms the domain.
SITE_URL=

# Endpoint that receives the contact form as JSON (see README, "Formulario").
# While empty, the form is NOT rendered and the contact page offers phone and email only.
PUBLIC_FORM_ENDPOINT=
