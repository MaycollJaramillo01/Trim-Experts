# Copy to .env for local use. Never commit real values: this repository is public.
# On Vercel, set these in Settings → Environment Variables.

# Production origin, e.g. https://www.example.com (no trailing path).
# Required by `npm run build`. Used for canonicals, Open Graph URLs, sitemap and JSON-LD.
SITE_URL=

# Contact form (src/pages/api/estimate.ts). The form is rendered only when
# SMTP_HOST, SMTP_USER and SMTP_PASSWORD are all set at build time.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional recipient(s), comma-separated. Defaults to the business email in src/data/business.ts.
CONTACT_TO=
# Optional Cc recipient(s), comma-separated, e.g. the website provider. The privacy policy then mentions the copy.
CONTACT_CC=
