---
import { Image } from 'astro:assets';
import { business } from '../data/business';
import logo from '../assets/logo/trim-experts-gold.png';
---

<!-- Same URL in header and footer, so eager costs nothing extra in the footer. -->
<a class="wordmark" href="/"><Image src={logo} alt={business.name} width={180} densities={[1, 2]} loading="eager" /></a>
