---
// Rendered only when PUBLIC_FORM_ENDPOINT is set. Contract: see README ("Formulario").
import { business, formEndpoint } from '../data/business';
import { visibleServices } from '../data/services';

const options = [...visibleServices(false).map((s) => s.name), 'Other or not sure'];
---

<form class="form" id="estimate-form" action={formEndpoint} method="post" novalidate data-endpoint={formEndpoint}>
  <div class="form-row">
    <div class="field">
      <label for="f-name">Name</label>
      <input id="f-name" name="name" autocomplete="name" required maxlength="100" aria-describedby="e-name" />
      <p class="field-error" id="e-name"></p>
    </div>
    <div class="field">
      <label for="f-email">Email</label>
      <input id="f-email" name="email" type="email" autocomplete="email" required maxlength="254" aria-describedby="e-email" />
      <p class="field-error" id="e-email"></p>
    </div>
  </div>
  <div class="form-row">
    <div class="field">
      <label for="f-phone">Phone <span class="hint">(optional)</span></label>
      <input id="f-phone" name="phone" type="tel" autocomplete="tel" maxlength="25" aria-describedby="e-phone" />
      <p class="field-error" id="e-phone"></p>
    </div>
    <div class="field">
      <label for="f-service">Service</label>
      <select id="f-service" name="service" required aria-describedby="e-service">
        <option value="">Choose a service</option>
        {options.map((o) => <option>{o}</option>)}
      </select>
      <p class="field-error" id="e-service"></p>
    </div>
  </div>
  <div class="field">
    <label for="f-location">Project location</label>
    <span class="hint" id="h-location">Brooklyn neighborhood or address</span>
    <input id="f-location" name="location" autocomplete="street-address" required maxlength="120" aria-describedby="h-location e-location" />
    <p class="field-error" id="e-location"></p>
  </div>
  <div class="field">
    <label for="f-message">Project description</label>
    <span class="hint" id="h-message">What you want done, approximate measurements, and your goal. You can email photos to {business.email}.</span>
    <textarea id="f-message" name="message" required minlength="20" maxlength="3000" aria-describedby="h-message e-message"></textarea>
    <p class="field-error" id="e-message"></p>
  </div>
  <div class="hp" aria-hidden="true">
    <label for="f-company">Leave this field empty</label>
    <input id="f-company" name="company_website" tabindex="-1" autocomplete="off" />
  </div>
  <p class="fine">We use the details you send only to respond to your inquiry. See our <a href="/privacy/">Privacy Policy</a>.</p>
  <div>
    <button class="btn btn--primary" type="submit">Request a Project Estimate</button>
  </div>
  <div class="form-status" role="status" aria-live="polite" tabindex="-1"></div>
</form>

<script>
  import { validateLead, type Lead } from '../lib/lead';

  const form = document.querySelector<HTMLFormElement>('#estimate-form');
  const startedAt = Date.now();

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
    const lead: Lead = { name: data.name, email: data.email, phone: data.phone, service: data.service, location: data.location, message: data.message };
    const errors = validateLead(lead);
    const status = form.querySelector<HTMLElement>('.form-status')!;
    status.textContent = '';

    for (const key of Object.keys(lead) as (keyof Lead)[]) {
      const input = form.elements.namedItem(key) as HTMLInputElement;
      input.setAttribute('aria-invalid', String(Boolean(errors[key])));
      form.querySelector(`#e-${key}`)!.textContent = errors[key] ?? '';
    }
    const firstInvalid = form.querySelector<HTMLElement>('[aria-invalid="true"]');
    if (firstInvalid) return firstInvalid.focus();

    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    button.disabled = true;
    button.textContent = 'Sending...';
    try {
      const res = await fetch(form.dataset.endpoint!, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ ...lead, company_website: data.company_website, startedAt }),
      });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      status.dataset.state = 'success';
      status.textContent = 'Your request was sent to Trim Experts. Thank you.';
    } catch {
      status.dataset.state = 'error';
      status.textContent = 'Your request could not be sent. Please try again, or call or email Trim Experts directly.';
    } finally {
      button.disabled = false;
      button.textContent = 'Request a Project Estimate';
      status.focus();
    }
  });
</script>
