---
// Describes what this build actually does. Revisit when hosting, analytics or the form provider change.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { business, formEndpoint } from '../data/business';
import { CONTACT_CC } from 'astro:env/server';

const updated = 'October 27, 2026';
const crumbs = [{ name: 'Privacy Policy', path: '/privacy/' }];
---

<Base
  title="Privacy Policy | Trim Experts"
  description="How the Trim Experts website handles information: what you send us, cookies, embedded Instagram videos and server logs."
  crumbs={crumbs}
>
  <PageHero
    title="Privacy Policy"
    eyebrow={`Last updated: ${updated}`}
    lead="This policy explains what information this website handles and how. It covers the website only."
    crumbs={crumbs}
  />

  <section class="section" aria-label="Policy">
    <div class="container prose policy">
      <h2>Who we are</h2>
      <p>
        This website belongs to {business.name}, serving {business.area.full}. You can reach us at
        <a href={business.phone.href}>{business.phone.display}</a> or <a href={`mailto:${business.email}`}>{business.email}</a>.
      </p>

      <h2>Information you send us</h2>
      <p>
        When you call or email us, we receive the information you choose to share, such as your name, phone number, email
        address, project location, project description and photos. We use it to respond to your inquiry and to discuss or
        prepare an estimate for your project. We do not sell it.
      </p>
      {formEndpoint ? (
        <p>
          The contact form sends your name, email, phone (if provided), selected service, project location and description to
          this website's server, which emails them to Trim Experts through a Microsoft 365 email account managed by our
          website provider. A copy of each message may remain in that account's sent mail{CONTACT_CC
            ? ', and a copy of each request is also sent to our website provider'
            : ''}. The form also sends the time you
          started filling it in and a hidden empty field, and your IP address is checked briefly to limit repeated
          submissions; these are used only to filter out automated spam.
        </p>
      ) : (
        <p>This website does not currently include an online form. Inquiries are made by phone or email.</p>
      )}

      <h2>Cookies and analytics</h2>
      <p>
        This website does not set its own cookies and does not use analytics, advertising or tracking tools. The menu, photo
        viewer and video buttons work in your browser without storing information about you.
      </p>

      <h2>Embedded Instagram videos</h2>
      <p>
        Project videos are hosted on Instagram. Nothing from Instagram loads when you open a page. If you choose "Play here",
        the video loads from Instagram, which is operated by Meta, and Instagram may then collect information under its own
        privacy policy. You can instead follow the "Watch on Instagram" link to view the video on Instagram.
      </p>

      <h2>Links to other websites</h2>
      <p>This website links to our Instagram and Yelp pages. Those websites have their own privacy practices.</p>

      <h2>Hosting and server logs</h2>
      <p>
        This website is hosted by Vercel. Like most hosts, the servers that deliver these pages may record standard technical
        information for each request, such as IP address, browser type, page requested and time, as part of normal operation
        and security.
      </p>

      <h2>Questions</h2>
      <p>
        To ask about information you have sent us, contact us at <a href={`mailto:${business.email}`}>{business.email}</a>.
        If this policy changes, the date at the top of this page will be updated.
      </p>
    </div>
  </section>
</Base>
