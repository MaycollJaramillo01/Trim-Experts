---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { business } from '../data/business';
---

<Base title="Page Not Found | Trim Experts" description="The page you were looking for could not be found." noindex>
  <PageHero title="Page not found" eyebrow="Error 404" lead="The page you were looking for does not exist or has moved.">
    <div class="btn-row">
      <a class="btn btn--inverse" href="/">Go to the home page</a>
      <a class="btn btn--outline-inverse" href="/services/">View services</a>
    </div>
  </PageHero>
  <section class="section">
    <div class="container prose">
      <p class="lead">Need help with a project? Call <a href={business.phone.href}>{business.phone.display}</a> or <a href="/contact/">contact us</a>.</p>
    </div>
  </section>
</Base>
